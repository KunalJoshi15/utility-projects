# Study Tracker Discord Bot Token
STUDY_BOT_TOKEN=your_study_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_optional

# AI Model Configuration (APInex Integration & Google Gemini)
APINEX_API_KEY=your_apinex_api_key_here
APINEX_BASE_URL=https://api.apinex.bond/v1
GEMINI_MODEL=free/gemini-3.8-flash
AI_PROVIDER=apinex

# Direct Google Gemini AI API Key (Optional fallback from https://aistudio.google.com/)
GEMINI_API_KEY=

# Logging
LOG_LEVEL=INFO
