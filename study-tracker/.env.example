# ==========================================
# Study Tracker & AI Interview Coach Bot Config
# ==========================================

# Discord Bot Token
STUDY_BOT_TOKEN=your_study_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_optional

# ==========================================
# Google Gemini & Google Cloud Vertex AI Config
# ==========================================
# Option 1: Direct Gemini API Key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Option 2: Vertex AI API Key or Express Mode
VERTEX_API_KEY=
# Google Cloud Project & Location
GCP_PROJECT_ID=seraphic-rune-366616
GCP_LOCATION=us-central1
# Model: gemini-2.5-flash (default/recommended), gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# AI Provider: auto, gemini, vertex, openrouter
AI_PROVIDER=auto

# AI Model Configuration (OpenRouter Integration - Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_SITE_URL=https://discord-job-bot.local
OPENROUTER_APP_NAME=Study Tracker Coach Bot

# Database & Storage
STUDY_DATABASE_URL=sqlite+aiosqlite:///./data/study_tracker.db

# Defaults
DEFAULT_POMODORO_MINUTES=25
DEFAULT_DAILY_GOAL_MINUTES=120
LOG_LEVEL=INFO

