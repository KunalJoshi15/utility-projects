# ==========================================
# Discord Job Search & Auto-Apply Bot Config
# ==========================================

# Discord Bot Token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Guild ID for fast slash command testing (optional, leave empty for global sync)
DISCORD_GUILD_ID=

# AI Model Configuration (APInex Integration or Google Gemini)
# Use APInex integration with free/gemini-3.8-flash model:
APINEX_API_KEY=your_apinex_api_key_here
APINEX_BASE_URL=https://api.apinex.bond/v1
GEMINI_MODEL=free/gemini-3.8-flash
AI_PROVIDER=apinex

# Direct Google Gemini AI API Key (Optional fallback from https://aistudio.google.com/)
GEMINI_API_KEY=

# RapidAPI Key for JSearch Job Aggregation (Optional)
# Get a free key at: https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna API credentials (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Encryption key for securing stored user session cookies/tokens (Auto-generated if empty)
DATA_ENCRYPTION_KEY=

# Database configuration (SQLite default is 100% free and stored on disk)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Storage directory for resumes and application screenshots
DATA_DIR=./data
RESUME_STORAGE_DIR=./data/resumes
SCREENSHOT_STORAGE_DIR=./data/screenshots

# Browser Automation Settings (Playwright Headless)
HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=45000
MAX_CONCURRENT_APPLICATIONS=3

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
